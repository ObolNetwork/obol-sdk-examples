{
  // Type-checks the plain JavaScript against the SDK's types (CI and
  // `yarn typecheck`); nothing is compiled. "Bundler" resolution for the same
  // reason as TS-Example/tsconfig.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.js"]
}

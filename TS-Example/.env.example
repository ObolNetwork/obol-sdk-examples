# Copy to .env (git-ignored) and fill in what the flow you run needs.
# Every script defaults to a dry run; pass --execute to sign / send / write.

# Network: hoodi (default) or mainnet. Mainnet spends real ETH and writes to
# production data; it is never used unless set here explicitly.
# OBOL_NETWORK=hoodi

# Obol API origin, without /v1. Defaults: hoodi -> the non-production dev API
# (https://obol-api-nonprod-dev.dev.obol.tech), mainnet -> https://api.obol.tech.
# The SDK only accepts the official Obol API URLs.
# OBOL_API_URL=https://obol-api-nonprod-dev.dev.obol.tech

# Throwaway Hoodi key for signing. Never use a key that holds mainnet funds.
# PRIVATE_KEY=0x...

# Execution RPC and beacon node (defaults: publicnode.com for the network).
# RPC_URL=https://ethereum-hoodi-rpc.publicnode.com
# BEACON_URL=https://ethereum-hoodi-beacon-api.publicnode.com

# create-cluster
# CLUSTER_NAME=my-cluster
# OPERATOR_ADDRESSES=0x...,0x...,0x...,0x...
# WITHDRAWAL_ADDRESS=0x...
# FEE_RECIPIENT_ADDRESS=0x...
# VALIDATOR_COUNT=1

# accept-cluster (from `charon enr`)
# OPERATOR_ENR=enr:-...

# watch-cluster (ms, 0 = until the lock is published)
# WATCH_TIMEOUT_MS=60000

# deposits
# DEPOSIT_AMOUNT_WEI=32000000000000000000
# EXPECTED_WITHDRAWAL_ADDRESS=0x...
# OVM_ADDRESS=0x...        # also used by withdrawal

# splits:rewards / splits:total ("address:percent", comma separated)
# REWARD_RECIPIENTS=0x...:50,0x...:49      # sums to 99; the SDK adds 1% Obol RAF
# PRINCIPAL_RECIPIENTS=0x...:50,0x...:50   # total split only; sums to 100
# PRINCIPAL_RECIPIENT=0x...                # rewards split only
# OVM_OWNER=0x...
# OWR_ADDRESS=0x...                        # splits:rewards --legacy: read an OWR

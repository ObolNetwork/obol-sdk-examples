    "@types/node": "^20.0.0",
    "esbuild": "^0.18.17",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@obolnetwork/obol-sdk": "^2.11.8",
    "dotenv": "^17.2.2",
    "ethers": "^6.4.0"
  }
}

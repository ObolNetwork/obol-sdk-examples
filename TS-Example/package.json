{
  "name": "obol-sdk-ts-examples",
  "version": "2.15.0",
  "private": true,
  "description": "Runnable TypeScript examples for @obolnetwork/obol-sdk, one script per flow",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "create-cluster": "node --env-file-if-exists=.env src/create-cluster.ts",
    "accept-cluster": "node --env-file-if-exists=.env src/accept-cluster.ts",
    "validate-lock": "node --env-file-if-exists=.env src/validate-lock.ts",
    "deposits": "node --env-file-if-exists=.env src/deposits.ts",
    "withdrawal": "node --env-file-if-exists=.env src/withdrawal.ts",
    "splits:rewards": "node --env-file-if-exists=.env src/splits-rewards.ts",
    "splits:total": "node --env-file-if-exists=.env src/splits-total.ts",
    "incentives": "node --env-file-if-exists=.env src/incentives.ts",
    "exits": "node --env-file-if-exists=.env src/exits.ts",
    "errors": "node --env-file-if-exists=.env src/errors.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@obolnetwork/obol-sdk": "^2.15.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}

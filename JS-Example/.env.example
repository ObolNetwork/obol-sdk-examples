# Copy to .env (git-ignored). The script is a dry run unless you pass --execute.
# Defaults: Hoodi (560048) + the non-production dev Obol API.
# OBOL_NETWORK=hoodi            # or mainnet (real ETH, production data)
# OBOL_API_URL=https://obol-api-nonprod-dev.dev.obol.tech
# PRIVATE_KEY=0x...             # throwaway Hoodi key
# OPERATOR_ADDRESSES=0x...,0x...,0x...,0x...
# WITHDRAWAL_ADDRESS=0x...
# FEE_RECIPIENT_ADDRESS=0x...
# OPERATOR_ENR=enr:-...         # accept as an operator (PRIVATE_KEY must be one)
# CONFIG_HASH=0x...             # accept/watch an existing definition instead of creating one
